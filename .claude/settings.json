{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(pnpx *)",
      "Bash(npx playwright *)",
      "Bash(npx turbo *)",
      "Bash(docker compose *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(node --version)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(pnpm *)",
      "PowerShell(pnpx *)",
      "PowerShell(npx playwright *)",
      "PowerShell(npx turbo *)",
      "PowerShell(docker compose *)",
      "PowerShell(docker ps *)",
      "PowerShell(docker logs *)",
      "PowerShell(node --version)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm * add *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm publish *)",
      "Bash(docker compose down *)",
      "Bash(docker compose rm *)",
      "PowerShell(pnpm add *)",
      "PowerShell(pnpm * add *)",
      "PowerShell(pnpm dlx *)",
      "PowerShell(pnpm publish *)",
      "PowerShell(docker compose down *)",
      "PowerShell(docker compose rm *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git branch *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git switch -c *)",
      "PowerShell(git branch *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./apps/*/.env)",
      "Read(./apps/*/.env.local)",
      "Read(./data/browser-profile/**)"
    ]
  }
}
