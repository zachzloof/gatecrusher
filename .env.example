# Gatecrusher environment
#
# Copy this file to `.env` in the repo root:   cp .env.example .env
# One file serves everything: web, worker, the db scripts and Docker Compose all read
# the root `.env`. Web and worker validate it at startup and exit with a message
# naming any variable that is missing or malformed (never its value).
#
# The defaults below match docker-compose.yml, so local development works unchanged.

# --- Shared (web + worker) -----------------------------------------------------------

# development | test | production. Optional, default: development.
NODE_ENV=development

# pino log level: fatal | error | warn | info | debug | trace | silent.
# Optional, default: info.
LOG_LEVEL=info

# Postgres connection string. Required.
# Host/port are the Compose-published ones on localhost; user, password and database
# must match the POSTGRES_* values below.
DATABASE_URL=postgres://gatecrusher:gatecrusher@localhost:5432/gatecrusher

# Redis connection string (BullMQ queue, live-event pub/sub, worker heartbeat). Required.
REDIS_URL=redis://localhost:6379

# Directory for the browser profile, downloads and screenshots, relative to the repo
# root (or absolute). Gitignored. Optional, default: ./data.
# The worker writes it; web only reads data/screenshots, to show them in the UI.
DATA_DIR=./data

# --- Web only ------------------------------------------------------------------------

# yt-dlp executable (name on PATH or a full path). Only used to read playlist metadata
# when SoundCloud's api-v2 fails; it never downloads audio. Optional, default: yt-dlp.
# Without yt-dlp installed, ingest still works as long as api-v2 does.
YT_DLP_PATH=yt-dlp

# --- Worker only ---------------------------------------------------------------------

# A download smaller than this many bytes is never accepted as a success (and, inside a
# zip, an audio file smaller than this does not count). Optional, default: 1048576 (1 MB).
MIN_DOWNLOAD_BYTES=1048576

# Leave unset. The worker's browser is always visible, because you have to be able to
# act in it; the worker and the login script refuse to start if this asks for headless.
HEADLESS=

# Anthropic API key for the AI browser-agent fallback. Optional until slice 5.
# Secret: never logged, never shown in the UI (Settings only says "set" / "not set").
ANTHROPIC_API_KEY=

# --- Docker Compose only -------------------------------------------------------------

# Credentials and database created by the Postgres container on first start.
# If you change these, change DATABASE_URL to match.
POSTGRES_USER=gatecrusher
POSTGRES_PASSWORD=gatecrusher
POSTGRES_DB=gatecrusher

# Host ports the containers publish on 127.0.0.1. Change one if it is already in use
# (and update DATABASE_URL / REDIS_URL to match).
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000
