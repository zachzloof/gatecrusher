{
  "name": "@gatecrusher/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "login": "node --env-file-if-exists=../../.env src/cli/login.ts",
    "enqueue-ping": "node --env-file-if-exists=../../.env src/cli/ping.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.test.ts\""
  },
  "dependencies": {
    "@gatecrusher/core": "workspace:*",
    "@gatecrusher/db": "workspace:*",
    "@gatecrusher/gates": "workspace:*",
    "bullmq": "^6.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "drizzle-orm": "^0.45.3",
    "vitest": "^5.0.3"
  }
}
