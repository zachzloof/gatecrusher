{
  "name": "@gatecrusher/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "next typegen && eslint .",
    "typecheck": "next typegen && tsc --noEmit",
