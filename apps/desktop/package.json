{
  "name": "@gatecrusher/desktop",
  "productName": "Gatecrusher",
  "version": "0.1.0",
  "private": true,
  "description": "Gatecrusher as a desktop app: web, worker and a private Postgres in one install.",
  "author": "Zach Zloof",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "bundle": "node scripts/bundle.mjs",
    "start": "node scripts/bundle.mjs && electron .",
    "dist": "node scripts/bundle.mjs && electron-builder --config electron-builder.yml --publish never",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.test.ts\"",
    "smoke": "playwright test"
  },
  "devDependencies": {
    "@gatecrusher/core": "workspace:*",
    "@gatecrusher/db": "workspace:*",
    "@gatecrusher/worker": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postgres": "^3.4.9",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
